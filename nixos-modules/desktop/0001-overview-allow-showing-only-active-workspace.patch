+#[test]
+fn overview_can_render_only_active_workspace() {
+    let ops = [
+        Op::AddOutput(1),
+        Op::AddWindow {
+            params: TestWindowParams::new(1),
+        },
+        Op::FocusWorkspaceDown,
+        Op::AddWindow {
+            params: TestWindowParams::new(2),
+        },
+        Op::ToggleOverview,
+        Op::CompleteAnimations,
+    ];
+
+    let default_layout = check_ops(ops.clone());
+    let MonitorSet::Normal { monitors, .. } = &default_layout.monitor_set else {
+        unreachable!()
+    };
+    assert!(monitors[0].workspaces_with_render_geo().count() > 1);
+
+    let mut options = Options::default();
+    options.overview.all_workspaces = false;
+    let active_only_layout = check_ops_with_options(options, ops);
+    let MonitorSet::Normal { monitors, .. } = &active_only_layout.monitor_set else {
+        unreachable!()
+    };
+    let mon = &monitors[0];
+    let visible = mon.workspaces_with_render_geo().collect::<Vec<_>>();
+    assert_eq!(visible.len(), 1);
+    assert_eq!(visible[0].0.id(), mon.active_workspace_ref().id());
+}
