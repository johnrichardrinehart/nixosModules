+static int evdev_get_criu_state(struct evdev *evdev,
+				struct evdev_client *client, void __user *p)
+{
+	struct input_criu_state state;
+	unsigned long irqflags;
+	unsigned int i;
+
+	if (copy_from_user(&state, p, sizeof(state)))
+		return -EFAULT;
+	if (state.version != EVDEV_CRIU_STATE_VERSION ||
+	    state.size != sizeof(state) || state.flags || state.clock_id ||
+	    state.queued_events || state.buffer_size ||
+	    memchr_inv(state.reserved, 0, sizeof(state.reserved)))
+		return -EINVAL;
+
+	memset(&state, 0, sizeof(state));
+	state.version = EVDEV_CRIU_STATE_VERSION;
+	state.size = sizeof(state);
+	state.clock_id = evdev_get_clk_id(client);
+	state.buffer_size = client->bufsize;
+
+	spin_lock_irqsave(&client->buffer_lock, irqflags);
+	state.queued_events = (client->head - client->tail) &
+			      (client->bufsize - 1);
+	if (state.queued_events)
+		state.flags |= EVDEV_CRIU_STATE_QUEUE_NONEMPTY;
+	for (i = 0; i < EV_CNT; i++) {
+		if (client->evmasks[i]) {
+			state.flags |= EVDEV_CRIU_STATE_FILTERED;
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&client->buffer_lock, irqflags);
+
+	if (rcu_access_pointer(evdev->grab) == client)
+		state.flags |= EVDEV_CRIU_STATE_GRABBED;
+	if (test_bit(EV_FF, evdev->handle.dev->evbit))
+		state.flags |= EVDEV_CRIU_STATE_FORCE_FEEDBACK;
+
+	if (copy_to_user(p, &state, sizeof(state)))
+		return -EFAULT;
+	return 0;
+}
