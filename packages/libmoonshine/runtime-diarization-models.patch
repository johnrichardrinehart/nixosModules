+std::string default_model_path(const char *filename) {
+  const char *override_dir = std::getenv("MOONSHINE_DIARIZATION_MODEL_DIR");
+  const std::filesystem::path model_dir =
+      override_dir != nullptr && override_dir[0] != '\0'
+          ? std::filesystem::path(override_dir)
+          : std::filesystem::path(MOONSHINE_DIARIZATION_MODEL_DIR);
+  return (model_dir / filename).string();
+}
+
+std::string read_model_metadata(const std::string &model_path) {
+  std::filesystem::path metadata_path(model_path);
+  metadata_path.replace_extension(".json");
+  std::ifstream input(metadata_path);
+  if (!input) {
+    throw std::runtime_error("unable to open diarization metadata: " +
+                             metadata_path.string());
+  }
+  return std::string(std::istreambuf_iterator<char>(input),
+                     std::istreambuf_iterator<char>());
+}
