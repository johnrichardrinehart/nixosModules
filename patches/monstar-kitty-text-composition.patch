@@ -476,7 +562,7 @@ test "blendAlphaSpan matches scalar blend" {
                 g.* = bg;
                 w.* = if (cov.* == 0) bg else blend(color, bg, cov.*);
             }
-            blendAlphaSpan(got[0..len], coverage[0..len], color);
+            blendAlphaSpan(got[0..len], coverage[0..len], color, .default);
