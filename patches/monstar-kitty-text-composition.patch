@@ -357,0 +373,63 @@ fn blend(fg: u32, bg: u32, alpha: u8) u32 {
+fn decodeSrgb(encoded: f32) f32 {
+    return if (encoded <= 0.04045)
+        encoded / 12.92
+    else
+        std.math.pow(f32, (encoded + 0.055) / 1.055, 2.4);
+}
+
+const srgb_decode_lut: [256]f32 = decode: {
+    @setEvalBranchQuota(1_000_000);
+    var lut: [256]f32 = undefined;
+    for (&lut, 0..) |*value, channel| {
+        value.* = decodeSrgb(@as(f32, @floatFromInt(channel)) / 255);
+    }
+    break :decode lut;
+};
+
+const srgb_encode_lut: [65536]u8 = encode: {
+    @setEvalBranchQuota(1_000_000);
+    var lut: [65536]u8 = undefined;
+    var encoded: u8 = 0;
+    var boundary = decodeSrgb(@as(f32, 0.5) / 255);
+    for (&lut, 0..) |*value, channel| {
+        const linear: f32 = @as(f32, @floatFromInt(channel)) / 65535;
+        while (encoded < 255 and linear >= boundary) {
+            encoded += 1;
+            boundary = decodeSrgb((@as(f32, @floatFromInt(encoded)) + 0.5) / 255);
+        }
+        value.* = encoded;
+    }
+    break :encode lut;
+};
+
+fn encodeLinear(linear: f32) u8 {
+    const index: u16 = @intFromFloat(@round(std.math.clamp(linear, 0, 1) * 65535));
+    return srgb_encode_lut[index];
+}
+
+fn blendKitty(fg: u32, bg: u32, coverage: u8) u32 {
+    if (coverage == 0xff) return fg;
+    const alpha: f32 = @as(f32, @floatFromInt(coverage)) / 255;
+    const inverse_alpha = 1 - alpha;
+    const bg_alpha_u8: u8 = @truncate(bg >> 24);
+    const bg_alpha: f32 = @as(f32, @floatFromInt(bg_alpha_u8)) / 255;
+    const out_alpha = alpha + bg_alpha * inverse_alpha;
+    const out_alpha_u8: u8 = @intFromFloat(@round(out_alpha * 255));
+
+    var result = @as(u32, out_alpha_u8) << 24;
+    inline for (.{ 16, 8, 0 }) |shift| {
+        const fg_channel: u8 = @truncate(fg >> shift);
+        const bg_premultiplied: u8 = @truncate(bg >> shift);
+        const bg_channel: u8 = if (bg_alpha_u8 == 0)
+            0
+        else
+            @intFromFloat(@round(@min(255, @as(f32, @floatFromInt(bg_premultiplied)) / bg_alpha)));
+        const premultiplied_linear =
+            srgb_decode_lut[fg_channel] * alpha +
+            srgb_decode_lut[bg_channel] * bg_alpha * inverse_alpha;
+        const encoded = if (out_alpha == 0) 0 else encodeLinear(premultiplied_linear / out_alpha);
+        const premultiplied_encoded: u8 = @intFromFloat(@round(@as(f32, @floatFromInt(encoded)) * out_alpha));
+        result |= @as(u32, premultiplied_encoded) << shift;
+    }
+    return result;
+}
