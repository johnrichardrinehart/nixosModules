+    try std.testing.expectEqual(@as(u32, 0x80808080), blendKitty(0xffffffff, 0x00000000, 128));
+    try std.testing.expectEqual(@as(u32, 0xff959cb6), blendKitty(0xffcad3f5, 0xff1a1b26, 128));
+}
